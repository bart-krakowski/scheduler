{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "ignorePatterns": [
    "dist/**",
    ".next/**",
    "build/**",
    "coverage/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "**/*.d.ts",
    "drizzle/**",
    "vitest.config.d.ts",
    "vitest.config.js"
  ]
}
