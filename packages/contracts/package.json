{
  "name": "@scheduler/contracts",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --external:@tanstack/time && tsc -p tsconfig.json --emitDeclarationOnly",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tanstack/time": "workspace:*"
  },
  "devDependencies": {
    "@scheduler/typescript": "workspace:*",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.58.0",
    "typescript": "^7.0.2"
  }
}
