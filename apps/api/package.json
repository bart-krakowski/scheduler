{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/main.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "start": "tsx --tsconfig ./tsconfig.json src/main.ts",
    "start:dev": "tsx watch --tsconfig ./tsconfig.json src/main.ts",
    "start:debug": "tsx watch --inspect-brk --tsconfig ./tsconfig.json src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "dev": "tsx watch --tsconfig ./tsconfig.json src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-express": "^12.0.1",
    "@scheduler/contracts": "workspace:*",
    "@tanstack/time": "workspace:*",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@scheduler/typescript": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.58.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
